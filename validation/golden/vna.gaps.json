      {
       "length_mm": 8.2,
       "looks_like": "usb2",
       "net": "USB_DP"
      }
     ]
    }
   ],
   "priority": "high",
   "where_to_find": "Interface standard or the device datasheets (e.g. 85/90/100 Ω differential). Nets in the class “Default” need their own net class in KiCad first (Board Setup → Net Classes, or net class directives in the schematic) – kisi.json can only set values of existing classes.",
   "write": {
    "example": {
     "diff": true,
     "profile": "usb2",
     "source": {
      "document": "USB 2.0 specification",
      "kind": "standard",
      "note": "90 Ω differential"
     },
     "target_ohm": 90
    },
    "to": "net_classes.<class>"
   }
  },
