diff --git a/src/fork/theme.js b/src/fork/theme.js
new file mode 100644
index 0000000..51c86bb
--- /dev/null
+++ b/src/fork/theme.js
@@ -0,0 +1,166 @@
+// Copyright (C) 2026 David Riehl
+// Part of a modified version (fork) of js_2d_fields by Henrik Forstén,
+// https://github.com/Ttl/js_2d_fields. This file is new in the fork and is licensed
+// under the GNU General Public License v3, like the rest of the project (see
+// LICENSE). See FORK.md for the list of changes.
+//
+// Light and dark theme. The original is dark only; the fork follows the browser's
+// preference (prefers-color-scheme) unless a theme is chosen:
+//   forkTheme.set('light' | 'dark' | 'auto')   ('auto': the browser's preference again)
+//   forkTheme.get()                            the theme shown: 'light' or 'dark'
+//   link key theme=light|dark (with or without src/fork/handover.js's other keys)
+// The page: CSS variables and a few rules of fork/theme.css under :root[data-theme="light"];
+// this classic script in <head> sets data-theme before the body is drawn. The plots: the
+// layout colours of the original's dark plot theme (darkAxis / darkBackground in plot.js)
+// and of the fork's menus, legend, titles and colour bars are swapped for light ones when a
+// plot is drawn, and back on a change of theme; the field colour scales and the lines drawn
+// on them stay as they are (they are drawn over the field, not over the background).
+(function () {
+    'use strict';
+    const root = document.documentElement;
+    const mq = window.matchMedia ? window.matchMedia('(prefers-color-scheme: light)') : null;
+    let chosen = null;   // 'light' | 'dark' | null (the browser's preference)
+    const fromLink = /[#&]theme=(light|dark|auto)(?:&|$)/.exec(location.hash);
+    if (fromLink && fromLink[1] !== 'auto') chosen = fromLink[1];
+    const shown = () => chosen || (mq && mq.matches ? 'light' : 'dark');
+
+    // Colours of the dark plot theme → light, by role (each map one to one, so a light plot
+    // maps back). Keys without spaces, lower case.
+    const ROLE_MAPS = {
+        bg: { '#2a2a2a': '#ffffff', '#1a1a1a': '#f6f6f6', '#1e1e1e': '#f2f2f2',
+              'rgba(30,30,30,0.7)': 'rgba(255,255,255,0.88)', 'rgba(15,15,15,0.9)': 'rgba(255,255,255,0.92)',
+              'rgba(30,30,30,0.55)': 'rgba(255,255,255,0.75)' },
+        fg: { '#fff': '#1b1b1b', '#ffffff': '#1b1b1b', '#aaa': '#505050', '#aaaaaa': '#505050',
+              '#ddd': '#262626', '#dddddd': '#262626', '#bbb': '#4a4a4a', '#bbbbbb': '#4a4a4a', '#ccc': '#3a3a3a',
+              '#888': '#666666', '#eee': '#202020' },
+        line: { '#444': '#d2d2d2', '#444444': '#d2d2d2', '#555': '#b8b8b8', '#555555': '#b8b8b8',
+                '#333': '#e0e0e0', '#666': '#a8a8a8' },
+    };
+    const norm = (v) => String(v).replace(/\s+/g, '').toLowerCase();
+    const MAPS = {};
+    for (const [role, m] of Object.entries(ROLE_MAPS)) {
+        const light = {}, dark = {};
+        for (const [d, l] of Object.entries(m)) { light[norm(d)] = l; dark[norm(l)] = d; }
+        MAPS[role] = { light, dark };
+    }
+    function mapColor(v, role, theme) {
+        if (typeof v !== 'string') return v;
+        const m = MAPS[role][theme];
+        return m[norm(v)] || v;
+    }
+    // role of a colour by its key
+    function roleOf(key) {
+        if (/bgcolor$/.test(key)) return 'bg';
+        if (/^(gridcolor|zerolinecolor|linecolor|bordercolor|outlinecolor|tickcolor)$/.test(key)) return 'line';
+        if (key === 'color') return 'fg';
+        return null;
+    }
+    // inline colours in a title or annotation text (the fork's subtitles)
+    const mapText = (s, theme) => (typeof s === 'string'
+        ? s.replace(/(color:\s*)(#[0-9a-fA-F]{3,6})/g, (_, p, c) => p + mapColor(c, 'fg', theme)) : s);
+    // keys of the layout that hold no plot-theme colours (or too much data to walk)
+    const SKIP = new Set(['shapes', 'images', 'sliders', 'selections', 'colorscale']);
+    function themeObj(o, theme, depth = 0) {
+        if (!o || typeof o !== 'object' || depth > 6) return o;
+        if (Array.isArray(o)) return o.map((x) => themeObj(x, theme, depth + 1));
+        const out = {};
+        for (const [k, v] of Object.entries(o)) {
+            if (SKIP.has(k)) { out[k] = v; continue; }
+            const role = roleOf(k);
+            if (role && typeof v === 'string') out[k] = mapColor(v, role, theme);
+            else if (k === 'text') out[k] = mapText(v, theme);
+            else if (v && typeof v === 'object' && !ArrayBuffer.isView(v) && !(Array.isArray(v) && typeof v[0] !== 'object')) out[k] = themeObj(v, theme, depth + 1);
+            else out[k] = v;
+        }
+        return out;
+    }
+    const themeLayout = (layout, theme) => (layout ? themeObj(layout, theme) : layout);
+    // traces: only their colour bars (the field itself keeps its colours)
+    function themeTrace(t, theme) {
+        if (!t || typeof t !== 'object') return t;
+        let out = t;
+        if (t.colorbar) out = { ...out, colorbar: themeObj(t.colorbar, theme) };
+        if (t.marker && t.marker.colorbar) out = { ...out, marker: { ...t.marker, colorbar: themeObj(t.marker.colorbar, theme) } };
+        return out;
+    }
+    const themeData = (data, theme) => (Array.isArray(data) ? data.map((t) => themeTrace(t, theme)) : data);
+    // relayout / update objects: 'xaxis.gridcolor': '#444', 'updatemenus': [...], 'title.text': '…'
+    function themeUpdate(upd, theme) {
+        if (!upd || typeof upd !== 'object') return upd;
+        const out = {};
+        for (const [k, v] of Object.entries(upd)) {
+            const last = k.split('.').pop().replace(/\[\d+\]$/, '');
+            const role = roleOf(last);
+            if (role && typeof v === 'string') out[k] = mapColor(v, role, theme);
+            else if (last === 'text') out[k] = mapText(v, theme);
+            else if (v && typeof v === 'object' && !SKIP.has(last)) out[k] = themeObj(v, theme);
+            else out[k] = v;
+        }
+        return out;
+    }
+
+    let wrapped = null;
+    function wrapPlotly(P) {
+        if (!P || P === wrapped || P.__forkTheme) return;
+        const orig = { newPlot: P.newPlot, react: P.react, relayout: P.relayout, update: P.update };
+        const fig = (fn) => function (gd, data, layout, config) {
+            const th = shown();
+            if (data && !Array.isArray(data) && typeof data === 'object' && (data.data || data.layout)) {
+                return fn.call(this, gd, { ...data, data: themeData(data.data, th), layout: themeLayout(data.layout, th) });
+            }
+            return fn.call(this, gd, themeData(data, th), themeLayout(layout, th), config);
+        };
+        P.newPlot = fig(orig.newPlot);
+        P.react = fig(orig.react);
+        P.relayout = function (gd, a, b) {
+            const th = shown();
+            if (typeof a === 'string') return orig.relayout.call(this, gd, themeUpdate({ [a]: b }, th));
+            return orig.relayout.call(this, gd, themeUpdate(a, th));
+        };
+        P.update = function (gd, traceUpd, layoutUpd, idx) {
+            return orig.update.call(this, gd, traceUpd, themeUpdate(layoutUpd, shown()), idx);
+        };
+        P.__forkTheme = true;
+        wrapped = P;
+    }
+    // redraw the plots in the shown theme (their current colours are either theme's)
+    function rethemePlots() {
+        const P = window.Plotly;
+        if (!P || !P.react) return;
+        for (const gd of document.querySelectorAll('.js-plotly-plot')) {
+            if (!gd.layout || !gd.data) continue;
+            try { P.react(gd, gd.data, gd.layout, gd._context); } catch (e) { /* a plot being torn down */ }
+        }
+    }
+    function apply() {
+        const t = shown();
+        root.dataset.theme = t;
+        root.style.colorScheme = t;
+        rethemePlots();
+        window.dispatchEvent(new CustomEvent('fork-theme', { detail: t }));
+    }
+
+    window.forkTheme = {
+        get: shown,
+        set(t) {
+            const next = t === 'light' || t === 'dark' ? t : null;
+            if (next === chosen && root.dataset.theme === shown()) return;
+            chosen = next;
+            apply();
+        },
+        // for tests and other scripts: a layout in the shown theme
+        layout: (l) => themeLayout(l, shown()),
+    };
+    root.dataset.theme = shown();
+    root.style.colorScheme = shown();
+    if (mq) {
+        const onChange = () => { if (!chosen) apply(); };
+        if (mq.addEventListener) mq.addEventListener('change', onChange); else if (mq.addListener) mq.addListener(onChange);
+    }
+    window.addEventListener('hashchange', () => {
+        const m = /[#&]theme=(light|dark|auto)(?:&|$)/.exec(location.hash);
+        if (m) window.forkTheme.set(m[1]);
+    });
+    if (window.Plotly) wrapPlotly(window.Plotly);
+    window.addEventListener('plotly-loaded', () => wrapPlotly(window.Plotly));
+})();
